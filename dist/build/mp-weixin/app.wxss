page{background:#f4f6f3;color:#23392f;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,PingFang SC,sans-serif;font-size:28rpx;line-height:1.55}view,text,input,textarea,button{box-sizing:border-box}button{font-size:28rpx;margin:0;border-radius:18rpx;line-height:1.4;padding:24rpx 30rpx;font-weight:600}button:after{border:0}button[disabled]{opacity:.48}button.primary{background:#246d53;color:#fff}button.secondary{background:#edf4ee;color:#246d53}button.danger{background:#fff0ed;color:#b75d44}button.small{padding:14rpx 22rpx;font-size:24rpx;border-radius:12rpx}.page{padding:30rpx 32rpx 190rpx;max-width:1000rpx;margin:auto}.row{display:flex;align-items:center;gap:18rpx}.between{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.grow{flex:1;min-width:0}.muted{color:#849087;font-size:24rpx}.eyebrow{font-size:21rpx;letter-spacing:4rpx;color:#778e7d}.title{font-size:44rpx;font-weight:750;letter-spacing:1rpx}.section-title{font-size:31rpx;font-weight:650;margin:34rpx 0 20rpx}.card{background:#fff;border:1rpx solid #e8eee6;border-radius:24rpx;padding:28rpx;margin-bottom:20rpx}.tag{font-size:21rpx;padding:7rpx 15rpx;border-radius:9rpx;background:#edf4ed;color:#36775c;white-space:nowrap}.tag.pending{background:#fff4dd;color:#997027}.tag.closed{background:#f0f1ef;color:#8c938d}.demo-banner{font-size:22rpx;color:#927346;background:#fcf3de;border:1rpx solid #f0e7d0;border-radius:12rpx;padding:14rpx 20rpx;margin:24rpx 0}.field-label{display:block;font-size:25rpx;color:#66756b;margin:22rpx 0 12rpx}.input{height:90rpx;border-radius:14rpx;border:1rpx solid #dfe7df;background:#f8faf7;padding:0 22rpx;width:100%;font-size:28rpx}.textarea{width:100%;min-height:150rpx;border:1rpx solid #dfe7df;background:#f8faf7;border-radius:14rpx;padding:20rpx;font-size:27rpx}.divider{height:1rpx;background:#edf0ea;margin:24rpx 0}.error{color:#b44e3d;background:#fff2ed;border-radius:14rpx;padding:20rpx;margin:20rpx 0;font-size:25rpx}.empty{text-align:center;padding:70rpx 24rpx;color:#8c988e}.empty-symbol{font-size:65rpx;color:#bbcabe;display:block;margin-bottom:20rpx}.bottom-nav{position:fixed;bottom:0;left:0;right:0;background:rgba(255,255,255,.98);border-top:1rpx solid #e7ede5;padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));display:flex;justify-content:space-around;z-index:20}.nav-item{position:relative;display:flex;flex-direction:column;align-items:center;gap:3rpx;color:#96a097;font-size:21rpx;padding:0 30rpx}.nav-item.active{color:#256c52}.nav-icon{font-size:39rpx;line-height:1.2}.nav-dot{position:absolute;top:-16rpx;width:35rpx;height:5rpx;border-radius:5rpx;background:#256c52}.product-mark{width:86rpx;height:96rpx;border-radius:16rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.product-mark text{font-size:34rpx;font-weight:700;opacity:.75}.product-mark image{width:100%;height:100%}.mint{background:#e8f0e3;color:#5d8553}.blue{background:#eaf0f7;color:#6a8da6}.sand{background:#f5eddf;color:#ac8b4d}.rose{background:#f5e6e4;color:#ad7770}.product-name{font-size:28rpx;font-weight:600}.price{color:#2e7054;font-weight:700}.action-bar{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1rpx solid #e7ede5;padding:22rpx 32rpx calc(22rpx + env(safe-area-inset-bottom));z-index:10}.action-bar .row button{flex:1}.tabs{display:flex;gap:16rpx;white-space:nowrap;margin:24rpx 0}.tab{padding:16rpx 26rpx;background:#eaf0e8;border-radius:13rpx;color:#71806f;font-size:25rpx}.tab.active{background:#286f55;color:#fff}.meta-row{display:flex;justify-content:space-between;padding:10rpx 0;font-size:25rpx;gap:20rpx}.meta-row text:last-child{text-align:right;word-break:break-all}.hint{font-size:23rpx;color:#8b957f;line-height:1.7}.history{padding-left:22rpx;border-left:2rpx solid #dce7d8;margin:20rpx 0}.history text{display:block}.status-number{font-size:50rpx;font-weight:700;line-height:1.2}.link{color:#397756;font-size:24rpx}.spacer{height:24rpx}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}